[sub_resource type="Shader" id="Shader_grid"]
code = "shader_type spatial;\nvarying vec3 wpos;\nvoid vertex() {\n\twpos = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz;\n}\nvoid fragment() {\n\tvec2 c = wpos.xz / 2.0;\n\tvec2 g = abs(fract(c - 0.5) - 0.5) / fwidth(c);\n\tfloat line = min(g.x, g.y);\n\tfloat m = 1.0 - min(line, 1.0);\n\tALBEDO = mix(vec3(0.36, 0.5, 0.36), vec3(0.2, 0.3, 0.2), m);\n\tROUGHNESS = 1.0;\n}\n"

